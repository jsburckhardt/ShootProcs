<Window x:Class="ShootProcs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShootProcs.App"
        Title="ShootProcs" Width="1500" Height="960" MinWidth="1100" MinHeight="740" Background="#0B1019"
        WindowStartupLocation="CenterScreen" Icon="Assets/ShootProcs.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <Border Background="#101925" BorderBrush="#243247" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#193C35" CornerRadius="11" Width="42" Height="42" Margin="0,0,12,0">
                        <TextBlock Text="&#x2316;" FontSize="32" Foreground="#6BF4C5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ShootProcs" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="SYSTEM INTELLIGENCE. ARCADE INSTINCT." FontSize="9" Foreground="#8297AF"/>
                    </StackPanel>
                    <Border Background="#19362D" CornerRadius="5" Margin="18,0,0,0" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" Foreground="#6BF4C5" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <ToggleButton x:Name="SafeToggle" Grid.Column="1" IsChecked="True" Margin="8,0"
                              VerticalAlignment="Center" Checked="SafeChanged" Unchecked="SafeChanged"
                              AutomationProperties.AutomationId="SafeMode" ToolTip="ON: confirm each shot. OFF: immediate direct termination.">
                    <TextBlock x:Name="SafeLabel" Text="SAFE MODE  /  ON" FontWeight="SemiBold"/>
                </ToggleButton>
                <Button x:Name="ElevationButton" Grid.Column="2" Content="Enable tracing" Margin="8,0,0,0"
                        VerticalAlignment="Center" Click="Elevate" ToolTip="Explicitly restart elevated for kernel disk and network telemetry."/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#243247" BorderThickness="0,0,1,0" Background="#0E1622">
                <DockPanel Margin="10,20">
                    <Button x:Name="RepositoryButton" DockPanel.Dock="Bottom" Margin="0,20"
                            HorizontalAlignment="Center" Padding="12" Click="OpenRepository"
                            ToolTip="Open ShootProcs on GitHub (opens your browser)"
                            AutomationProperties.Name="Open ShootProcs repository on GitHub"
                            AutomationProperties.AutomationId="RepositoryLink">
                        <Viewbox Width="24" Height="24">
                            <Path Width="24" Height="24" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 .297C5.37 .297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.467-1.332-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297 24 5.67 18.627 .297 12 .297Z"/>
                        </Viewbox>
                    </Button>
                    <StackPanel>
                        <ToggleButton x:Name="ArenaNav" IsChecked="True" Click="ShowArena" Padding="5,14" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="&#x25CE;" FontSize="25" HorizontalAlignment="Center"/>
                                <TextBlock Text="Arena" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ExplorerNav" Click="ShowExplorer" Padding="5,14">
                            <StackPanel><TextBlock Text="&#x2637;" FontSize="25" HorizontalAlignment="Center"/>
                                <TextBlock Text="Explorer" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="26,20,26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="108"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Your machine. Your move." FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Headline" Text="Establishing a live baseline..." Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="GroupCount" Text="SCANNING APPLICATIONS" FontSize="10" Foreground="#8EA2BA" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="SamplingLabel" Text="1 SECOND TELEMETRY / UP TO 30 FPS" FontFamily="Cascadia Mono"
                                   FontSize="9" Foreground="#5F7794" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel><TextBlock Text="CPU  /  ALL CORES" Style="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock x:Name="CpuValue" Text="--" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <local:Sparkline x:Name="CpuChart" Width="90" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel><TextBlock Text="PHYSICAL MEMORY" Style="{StaticResource Muted}" FontSize="10"/>
                                <TextBlock x:Name="MemoryValue" Text="--" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <local:Sparkline x:Name="MemoryChart" Width="70" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="PHYSICAL DISK I/O" Style="{StaticResource Muted}" FontSize="10"/>
                            <TextBlock x:Name="DiskValue" Text="Unavailable" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="DiskNote" Text="Kernel tracing requires elevation" FontSize="9" Foreground="#8E9DB6"/></StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="NETWORK  /  TCP + UDP" Style="{StaticResource Muted}" FontSize="10"/>
                            <TextBlock x:Name="NetworkValue" Text="Unavailable" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="Activity, not a slowdown verdict" FontSize="9" Foreground="#8E9DB6"/></StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                        <Grid x:Name="ArenaToolbar">
                            <StackPanel x:Name="Modes" Orientation="Horizontal" VerticalAlignment="Top">
                                <ToggleButton Content="Overall" Tag="Overall" IsChecked="True" Click="ModeChanged" Margin="0,0,5,0"/>
                                <ToggleButton Content="CPU" Tag="CPU" Click="ModeChanged" Margin="0,0,5,0"/>
                                <ToggleButton Content="Memory" Tag="Memory" Click="ModeChanged" Margin="0,0,5,0"/>
                                <ToggleButton Content="Disk" Tag="Disk" Click="ModeChanged" Margin="0,0,5,0"/>
                                <ToggleButton Content="Network" Tag="Network" Click="ModeChanged"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ExplorerToolbar" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,14,9">
                                <TextBox x:Name="SearchBox" TextChanged="FilterChanged" AutomationProperties.AutomationId="Search"
                                         AutomationProperties.Name="Search applications, paths or PID"
                                         ToolTip="Search application or process name, executable path, or process ID"/>
                                <TextBlock Text="Search applications, paths or PID" IsHitTestVisible="False"
                                           Margin="13,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#6C829E">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <CheckBox x:Name="BackgroundToggle" Grid.Column="1" Content="Background" Checked="FilterChanged" Unchecked="FilterChanged"/>
                        </Grid>
                        <Border x:Name="ArenaFrame" Grid.Row="1" CornerRadius="14" BorderBrush="#293C50" BorderThickness="1" ClipToBounds="True">
                            <local:ArenaControl x:Name="Arena"/>
                        </Border>
                        <Border x:Name="ExplorerFrame" Grid.Row="1" CornerRadius="14" BorderBrush="#293C50" BorderThickness="1"
                                Visibility="Collapsed" ClipToBounds="True">
                            <DataGrid x:Name="ExplorerGrid" AutoGenerateColumns="False" SelectionChanged="ExplorerSelected"
                                      RowDetailsVisibilityMode="Collapsed" AutomationProperties.AutomationId="Explorer">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="APPLICATION" SortMemberPath="Name" Width="2*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <Grid Margin="7,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="+" Padding="4,2" Click="ExpandGroup" FontSize="12" Background="Transparent" BorderThickness="0"
                                                        AutomationProperties.Name="Expand processes"/>
                                                <Image Grid.Column="1" Source="{Binding Icon}" Width="23" Height="23"/>
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtext}" FontSize="10" Foreground="#7C93AE" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="IMPACT" SortMemberPath="Score" Width="90">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel Margin="8" ToolTip="{Binding Explanation}">
                                                <TextBlock Text="{Binding ScoreText}" Foreground="#6BF4C5"/>
                                                <local:Sparkline Values="{Binding History}" Height="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CPU" SortMemberPath="Cpu" Width="90">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <StackPanel Margin="7"><TextBlock Text="{Binding CpuText}"/>
                                                <ProgressBar Value="{Binding Cpu, Mode=OneWay}" Maximum="100" Height="3" Margin="0,5,0,0"
                                                             Foreground="#6BF4C5" Background="#253248" BorderThickness="0"/></StackPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="PRIVATE COMMIT" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="115"/>
                                    <DataGridTextColumn Header="DISK /s" Binding="{Binding DiskText}" SortMemberPath="Disk" Width="100"/>
                                    <DataGridTextColumn Header="NETWORK /s" Binding="{Binding NetworkText}" SortMemberPath="Network" Width="108"/>
                                </DataGrid.Columns>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="#0C1521" Padding="20,10">
                                            <ItemsControl ItemsSource="{Binding Processes}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Identity.Pid}" Foreground="#849CB7" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   ToolTip="{Binding Executable}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PrivateBytes, StringFormat={}{0:N0} B}" FontSize="10" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3" Content="End" Click="EndProcess" Padding="8,4" FontSize="10"
                                                                IsEnabled="{Binding CanTerminate}"
                                                                ToolTip="{Binding ProtectionReason}"/>
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </Border>
                        <Grid Grid.Row="2" Margin="2,6,0,0">
                            <TextBlock x:Name="FieldNote" Text="Hover to inspect. Click to shoot. Safe Mode confirms every shot."
                                       FontSize="10" Foreground="#7F96AF" VerticalAlignment="Center"/>
                            <CheckBox x:Name="MotionToggle" Content="Reduced motion" HorizontalAlignment="Right" Checked="MotionChanged"
                                      Unchecked="MotionChanged" FontSize="10"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <Button x:Name="ShootButton" Content="SHOOT APPLICATION" Click="ShootSelected" IsEnabled="False"
                                        Background="#6BF4C5" Foreground="#0D231C" BorderBrush="#6BF4C5" FontWeight="Bold"
                                        Padding="12,13" AutomationProperties.AutomationId="Shoot"/>
                                <TextBlock x:Name="ActionScope" Text="Direct termination. Unsaved work may be lost." FontSize="10" Foreground="#7D94AD"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="TARGET INTELLIGENCE" FontSize="10" Foreground="#6BF4C5" FontFamily="Cascadia Mono"/>
                                <Grid Margin="0,22,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#203046" CornerRadius="12" Width="46" Height="46">
                                        <Image x:Name="InspectorIcon" Width="31" Height="31"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="InspectorName" Text="Choose a target" FontSize="17" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="InspectorCount" Text="Hover an icon or select a row" FontSize="10" Foreground="#8E9DB6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#192C2C" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="PERFORMANCE IMPACT" FontSize="9" Foreground="#8FB8AD"/>
                                        <TextBlock x:Name="InspectorScore" Text="--" FontSize="34" Foreground="#6BF4C5" Margin="0,5,0,0"/>
                                        <local:Sparkline x:Name="InspectorChart" Height="35" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                    <TextBlock Text="CPU" Style="{StaticResource Muted}"/><TextBlock x:Name="InspectorCpu" Grid.Column="1" Text="--"/>
                                    <TextBlock Grid.Row="1" Text="Private commit" Style="{StaticResource Muted}"/><TextBlock x:Name="InspectorMemory" Grid.Row="1" Grid.Column="1" Text="--"/>
                                    <TextBlock Grid.Row="2" Text="Disk" Style="{StaticResource Muted}"/><TextBlock x:Name="InspectorDisk" Grid.Row="2" Grid.Column="1" Text="--"/>
                                    <TextBlock Grid.Row="3" Text="Network" Style="{StaticResource Muted}"/><TextBlock x:Name="InspectorNetwork" Grid.Row="3" Grid.Column="1" Text="--"/>
                                </Grid>
                                <TextBlock Text="WHY IT MATTERS" FontSize="10" Foreground="#849CB7" Margin="0,0,0,8"/>
                                <TextBlock x:Name="InspectorReason" Text="Real measurements, not manufactured enemies. Overall weighs sustained consumption against actual machine pressure."
                                           TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="#B4C4D8"/>
                                <TextBlock x:Name="InspectorConfidence" Text="" FontSize="10" Foreground="#7C93AE" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InspectorProtection" Text="" Foreground="#FFB797" FontSize="11" Margin="0,12,0,12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#101925" BorderBrush="#253248" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Connecting to Windows..." VerticalAlignment="Center" FontSize="11" Foreground="#91A7BD"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="OverheadText" Grid.Column="1" VerticalAlignment="Center" FontSize="10" Foreground="#657E99"/>
            </Grid>
        </Border>
        <Grid x:Name="ConfirmationOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#C9080E17"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="490" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Padding="30">
                <StackPanel>
                    <TextBlock Text="CONFIRM YOUR SHOT" FontSize="11" Foreground="#FFB797" FontFamily="Cascadia Mono"/>
                    <TextBlock x:Name="ConfirmationTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,12"/>
                    <TextBlock x:Name="ConfirmationDetail" TextWrapping="Wrap" Foreground="#B6C7DB" LineHeight="21"/>
                    <TextBlock Text="Direct termination can discard unsaved work. This shot will not chase new or restarted instances."
                               TextWrapping="Wrap" FontSize="12" Foreground="#FFB797" Margin="0,18,0,24"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="CancelShotButton" Content="Keep running" Click="CancelShot" IsCancel="True"/>
                        <Button Grid.Column="2" x:Name="ConfirmShotButton" Content="Terminate captured processes" Click="ConfirmShot"
                                Background="#E58D73" Foreground="#20130F" BorderBrush="#E58D73" AutomationProperties.AutomationId="ConfirmShot"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

    { "id": "tests-text", "type": "text", "containerId": "tests", "x": 80, "y": 760, "width": 410, "height": 135, "text": "Behavior + Windows validation\nDisposable test processes only\nNative UI + installer acceptance", "fontSize": 18, "fontFamily": 1, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "os", "type": "rectangle", "x": 730, "y": 740, "width": 450, "height": 180, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "hachure", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "os-text" }] },

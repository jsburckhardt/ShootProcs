    { "id": "core-text", "type": "text", "containerId": "core", "x": 80, "y": 435, "width": 410, "height": 150, "text": "ShootProcs.Core\nGrouping + pressure scoring\nCaptured termination orchestration", "fontSize": 20, "fontFamily": 1, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "windows", "type": "rectangle", "x": 730, "y": 400, "width": 450, "height": 220, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "hachure", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "windows-text" }] },
    { "id": "windows-text", "type": "text", "containerId": "windows", "x": 750, "y": 435, "width": 410, "height": 150, "text": "ShootProcs.Windows\nIdentity + CPU/private memory\nOpt-in ETW + handle termination", "fontSize": 20, "fontFamily": 1, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },

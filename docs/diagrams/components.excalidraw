    { "id": "app-text", "type": "text", "containerId": "app", "x": 370, "y": 125, "width": 480, "height": 150, "text": "ShootProcs.App (WPF)\nArena + Process Explorer\nShared shell, inspector and Safe Mode", "fontSize": 20, "fontFamily": 1, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
